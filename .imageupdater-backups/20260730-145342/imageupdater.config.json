{
   "_comment": "Config for imageupdater. 'ref' is the image path exactly as it appears in your html/css today; the tool replaces it and then rewrites 'ref' here so the next update keeps working. 'files' limits which scanned files a slot may change; 'cssRule' limits it further to the url() inside that css rule only. Sizes are recommendations only (px) - edit them freely.",
   "imageDir": "img/CustomImage",
   "scan": [
      "*.html",
      "css/*.css",
      "styles/*.css",
      "js/*.js"
   ],
   "groups": [
      {
         "id": "logo",
         "label": "Logo",
         "note": "Used in the navbar and in the footer.",
         "width": 200,
         "height": 70,
         "slots": [
            {
               "id": "logo",
               "label": "Logo",
               "ref": "img/CustomImage/logo-20260730-134550.png",
               "files": [
                  "*.html"
               ]
            }
         ]
      },
      {
         "id": "banner",
         "label": "Banner sliders",
         "note": "Full screen slide backgrounds (inline background-image on .slide).",
         "width": 1920,
         "height": 1080,
         "slots": [
            {
               "id": "slide0",
               "label": "Slide 1",
               "ref": "img/CustomImage/slide0-20260730-132533.jpg",
               "cssRule": ".slide.slide-0",
               "files": [
                  "css/*.css",
                  "styles/*.css"
               ]
            },
            {
               "id": "slide1",
               "label": "Slide 2",
               "ref": "img/CustomImage/slide1-20260730-132533.jpg",
               "cssRule": ".slide.slide-1",
               "files": [
                  "css/*.css",
                  "styles/*.css"
               ]
            },
            {
               "id": "slide2",
               "label": "Slide 3",
               "ref": "img/CustomImage/slide2-20260730-141417.jpg",
               "cssRule": ".slide.slide-2",
               "files": [
                  "css/*.css",
                  "styles/*.css"
               ]
            }
         ]
      },
      {
         "id": "services",
         "label": "Services",
