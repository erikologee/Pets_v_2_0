               ]
            }
         ]
      },
      {
         "id": "stats",
         "label": "Stats",
         "note": "Middle layer of the animated #stats background (the two falling-bones layers in the same rule are left alone). Transparent PNG.",
         "width": 1920,
         "height": 600,
         "slots": [
            {
               "id": "stats-bg",
               "label": "Stats background",
               "ref": "img/CustomImage/stats-bg-20260730-134946.jpg",
               "cssRule": "#stats",
