               ]
            },
            {
               "id": "service5",
               "label": "Service 5",
               "ref": "img/service5.jpg",
               "files": [
                  "*.html"
               ]
            }
         ]
      },
      {
         "id": "about",
         "label": "About us",
         "note": "Illustration next to the About Us text. Transparent PNG recommended.",
         "width": 800,
         "height": 800,
         "slots": [
            {
               "id": "about-index",
               "label": "About us image",
               "ref": "img/about-index.png",
               "files": [
                  "*.html"
               ]
            }
         ]
