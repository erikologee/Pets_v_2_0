               "label": "Service 1",
               "ref": "img/CustomImage/service1-20260730-142550.jpg",
               "files": [
                  "*.html"
               ]
            },
            {
               "id": "service2",
               "label": "Service 2",
               "ref": "img/CustomImage/service2-20260730-142550.jpg",
               "files": [
                  "*.html"
               ]
            },
            {
               "id": "service3",
               "label": "Service 3",
               "ref": "img/service3.jpg",
               "files": [
